<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- 1週間の並び。上はタイトルの分、左右は矢印の分をあける（大きさは実行時に決める） -->
    <FrameLayout
        android:id="@+id/days_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inAnimation="@null"
            android:outAnimation="@null" />
    </FrameLayout>

    <!-- タイトル（月）。押すと今日の週に戻る -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:singleLine="true"
        android:textColor="#FFEDEDED" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:maxLines="4"
        android:textColor="#FFBDBDBD"
        android:visibility="gone" />

    <!-- 左右の矢印の押す場所。押せる／行き止まりの切り替えは表示の切り替えだけ -->
    <FrameLayout
        android:id="@+id/zones"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/zone_left_on"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/zone_left_on_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/arrow_bg"
                android:duplicateParentState="true"
                android:text="‹"
                android:textColor="@color/arrow_text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/zone_left_off"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/zone_left_off_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="‹"
                android:textColor="#40EDEDED" />
        </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/zone_right_on"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/zone_right_on_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/arrow_bg"
                android:duplicateParentState="true"
                android:text="›"
                android:textColor="@color/arrow_text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/zone_right_off"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/zone_right_off_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="›"
                android:textColor="#40EDEDED" />
        </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
